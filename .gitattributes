# Unity YAML files: keep line endings stable and use the smart merge tool if available
*.unity    text eol=lf
*.prefab   text eol=lf
*.asset    text eol=lf
*.meta     text eol=lf
*.anim     text eol=lf
*.controller text eol=lf
*.mat      text eol=lf
*.cs       text eol=lf diff=csharp
*.asmdef   text eol=lf
*.json     text eol=lf
*.md       text eol=lf

# Binary assets
*.png  binary
*.gif  binary
*.wav  binary
*.ttf  binary
*.wasm binary
*.data binary
*.unityweb binary
